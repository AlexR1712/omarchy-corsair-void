{
  "schemaVersion": 1,
  "id": "io.github.alexr1712.corsair-void",
  "name": "Corsair VOID",
  "version": "3.1.0",
  "author": "AlexR1712",
  "license": "MIT",
  "description": "Battery and audio controls for Corsair VOID Elite and VOID Wireless v2 headsets.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Corsair VOID",
    "description": "Monitor battery and wireless state; adjust native PipeWire volume, mute, default output, sidetone, and headset alerts.",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15,
      "showPercentage": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "showPercentage",
        "type": "boolean",
        "label": "Show battery percentage in bar",
        "defaultValue": true
      }
    ]
  }
}
